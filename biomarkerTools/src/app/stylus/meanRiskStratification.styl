#markers table
  width 100%

.input
  overflow auto
  width 100%
  max-width 480px
  margin 0px auto 1em
  @media (min-width 950px)
    float left
    padding-right 15px
  #control-group
    a:last-child::before
      content '\a0'
    .table_row:first-child
      @media (min-width 480px)
        float left
        width 70%
      @media (max-width 568px)
        font-size 11px
      .table_data
        width 25%
        &:nth-last-child(2)
          float right
        &:last-child
          width auto
    .table_row:last-child
      clear left
      .table_data
        overflow visible
        height auto
        min-height 2.2em
  .option-1, .option-2
    .table_row:first-child
      background-color #F5F5F5
  .option-1
    .table_data
      float right
      min-width 7em
      width (100%*1/3)
      &:last-child
        float none
        background-color #F5F5F5
        width auto
        text-align left
    @media (max-width 568px)
      font-size 11px
    @media (max-width 480px)
      .table_data
        height 4.2em
      .table_row:not(:first-child) .table_data:not(:last-child)
        line-height 4em
  .option-2
    .table_data
      &:first-child
        min-width 14em
      span
        float right
      div
        overflow auto
.output
  overflow auto
  @media (min-width 950px)
    padding-left 15px
  #paramTable
    margin-bottom 1em
  table
    width 100%
  td, th
    border solid #DDD
    border-width 0px 1px 1px 0px
    padding .1em .15em
    &:first-child
      border-left-width 1px
  th
    background-color #F5F5F5
    border-top-width 1px
    font-weight bold
